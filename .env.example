# ─── Meta / WhatsApp Business API ────────────────────────────────────────────
META_WABA_ID=                # ID de la cuenta de WhatsApp Business
META_PHONE_NUMBER_ID=        # ID del número de teléfono en Meta
META_ACCESS_TOKEN=           # Token de acceso de Meta Graph API
META_APP_SECRET=             # Secret de la App de Meta
META_VERIFY_TOKEN=           # Token de verificación del webhook
OWNER_NOTIFY_PHONE=          # Ej: +56912345678 (sesión activa en 24h)
SALES_NOTIFY_PHONE=          # Ventas — Sebastián Cabrera: notificación por cada lead nuevo

# ─── Odoo CRM ─────────────────────────────────────────────────────────────────
ODOO_URL=https://digitalseg1.odoo.com
ODOO_DB=digitalseg1
ODOO_USER=contacto@digitalseg.cl
ODOO_APIKEY=                 # Panel Odoo → Mi perfil → Claves de API
ODOO_SOURCE=13               # ID de la fuente de leads
ODOO_SALESPERSON_ID=6        # ID del vendedor asignado
ODOO_PROXY_URL=              # URL del proxy de Odoo (si aplica)

# ─── MercadoPago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...  # https://www.mercadopago.cl/developers → Credenciales
MP_BACK_URL=https://digitalseg.cl
MP_WEBHOOK_URL=https://digitalseg-backend-production.up.railway.app/api/pagos/webhook

# ─── Seguridad / CORS ─────────────────────────────────────────────────────────
DIGITALSEG_ALLOWED_ORIGIN=https://digitalseg.cl
PROXY_SECRET=                # Secret para autenticar el proxy interno

# ─── Agenda ───────────────────────────────────────────────────────────────────
AGENDA_ADMIN_KEY=            # Clave admin para la API de agenda
AGENDA_DATA_FILE=agenda.json

# ─── Email SMTP (Hostinger) ────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contacto@digitalseg.cl
SMTP_PASS=                   # Contraseña del email SMTP
